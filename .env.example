APP_NAME=PropCore Chatbot API
APP_ENV=development

GEMINI_PROVIDER=google
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS can be a file path or the raw service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (SaaS subscription billing) — test-mode keys from
# https://dashboard.razorpay.com/app/keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the webhook you create at Settings > Webhooks, pointed at
# https://<this-backend>/billing/webhook
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp chatbot (Meta WhatsApp Cloud API) — one webhook for all builders:
# https://<this-backend>/whatsapp/webhook
WHATSAPP_GRAPH_VERSION=v21.0
# Verify token + app secret of the PLATFORM Meta app. Builders using their own
# Meta app get a per-workspace verify token in Admin > WhatsApp Bot instead.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Public URL of this backend (shown to builders as their webhook URL)
PUBLIC_BACKEND_URL=
# Encrypts builders' WhatsApp access tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
